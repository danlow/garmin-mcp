# Copy to .env on the server and fill in. Never commit .env.

# Token Claude must send as "Authorization: Bearer <token>". Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Sign-in for the browser dashboard at /dashboard. Empty password = dashboard locked.
# Changing the password signs out every browser.
DASHBOARD_USERNAME=dan
DASHBOARD_PASSWORD=

# "fake" = sample data for testing, "garmin" = your real data.
GARMIN_SOURCE=fake

# Garmin Connect Personal API key: Garmin Connect Web > Personal API Key > Create Key.
# Shown only once; it expires after the period you chose (30 days to 1 year).
GARMIN_API_KEY=

SYNC_INTERVAL_MIN=60
INITIAL_SYNC_DAYS=180
LOOKBACK_DAYS=3
# /health/sync answers 503 ("stale") after this many minutes without a successful sync.
# Empty or 0 = 3 x SYNC_INTERVAL_MIN.
SYNC_STALE_MIN=
